    "next": "16.4.6",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "^4.0.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.7",
