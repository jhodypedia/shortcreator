    "@remotion/renderer": "^4.0.0",
    "@remotion/three": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "gsap": "^3.15.1",
    "jszip": "^3.10.1",
    "lenis": "^1.3.28",
    "lucide-react": "^1.79.0",
